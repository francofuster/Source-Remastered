<?xml version="1.0" encoding="utf-8"?>
<!-- Updates come from GitHub over HTTPS. Its downloads (the release files)
     are served from release-assets.githubusercontent.com, whose certificate
     chains to Let's Encrypt (ISRG Root X1). Android 7.0 does not have that
     root (it came in 7.1.1) and refused the connection, so the app carries
     the ISRG roots next to the system ones. Their SHA-256:
       X1 96BCEC06264976F37460779ACF28C5A7CFE8A3C0AAE11A8FFCEE05C0BDDF08C6
       X2 69729B8E15A86EFC177A57AFB7171DFC64ADD28C2FCA8CF1507E34453CCB1470
     Plain HTTP is allowed only to a test release server on this device
     (adb reverse) or on the emulator host. -->
<network-security-config>
    <base-config>
        <trust-anchors>
            <certificates src="system" />
            <certificates src="@raw/isrg_root_x1" />
            <certificates src="@raw/isrg_root_x2" />
        </trust-anchors>
    </base-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">10.0.2.2</domain>
    </domain-config>
</network-security-config>
